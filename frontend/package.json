{
  "name": "eilkurier-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "npm run sync-assets && vite dev",
    "build": "npm run sync-assets && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "api": "openapi-typescript openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
