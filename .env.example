# ============================================================================================
# Eilkurier – Konfiguration. Kopieren nach .env und anpassen. Alle Werte außer dem Passwort
# sind optional; ohne Sprachmodell erscheinen die Zeitungen trotzdem (Texte dann als Auszug).
# ============================================================================================

# --- Betrieb ---------------------------------------------------------------------------------
# Docker-Hub-Tag: latest oder ein Commit-Kürzel
EILKURIER_VERSION=latest
# Port der Weboberfläche im Heimnetz
EILKURIER_PORT=8080
TZ=Europe/Berlin
POSTGRES_PASSWORD=bitte-aendern
# Datenbank auf festen SSD-Pfad legen
# EILKURIER_DB_DIR=/srv/dev-disk-by-uuid-XXXX/eilkurier/db

# --- Haushalt --------------------------------------------------------------------------------
# signiert die Anmelde-Cookies
EILKURIER_SECRET_KEY=bitte-lange-zufaellige-zeichenkette
# leer = Weboberfläche ohne PIN
EILKURIER_HOUSEHOLD_PIN=
EILKURIER_TIMEZONE=Europe/Berlin
# Sprache, in der der Reporter schreibt (de|en)
EILKURIER_LANGUAGE=de
# für Wetter (DWD) und Sonnenzeiten
EILKURIER_LOCATION_NAME=Musterstadt
EILKURIER_LATITUDE=49.45
EILKURIER_LONGITUDE=11.86

# --- Sprachmodell ----------------------------------------------------------------------------
# Ziel: Jetson Orin Nano mit llama.cpp (Qwen3.5-9B + EmbeddingGemma), siehe deploy/jetson/README.md.
# Der Denkmodus ist dort im Server abgeschaltet, EILKURIER_LLM_EXTRA_BODY bleibt leer.
# leer = kein Sprachmodell
EILKURIER_LLM_URL=
# EILKURIER_LLM_URL=http://jetson.fritz.box:8080
EILKURIER_LLM_MODEL=qwen3.5-9b
# leer = Geschichten nur über Schlagworte zuordnen
EILKURIER_EMBEDDING_MODEL=embeddinggemma
EILKURIER_LLM_TIMEOUT_SECONDS=300

# Alternative zum Ausprobieren: captiva (vLLM, Qwen3.8 27B). Nur bei Bedarf einschalten (~800 W).
# EILKURIER_LLM_URL=http://captiva.fritz.box:8080
# EILKURIER_LLM_MODEL=qwen3.8
# EILKURIER_EMBEDDING_MODEL=
# EILKURIER_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Demo ohne Hardware (docker compose --profile demo up):
# EILKURIER_LLM_URL=http://simulator:11434

# --- Zustellung ------------------------------------------------------------------------------
# von @BotFather; leer = kein Telegram
EILKURIER_TELEGRAM_BOT_TOKEN=
# leer = kein E-Mail-Versand
EILKURIER_SMTP_HOST=
EILKURIER_SMTP_PORT=587
EILKURIER_SMTP_USER=
EILKURIER_SMTP_PASSWORD=
EILKURIER_SMTP_FROM=Eilkurier <eilkurier@example.org>
EILKURIER_SMTP_STARTTLS=true

# --- Pipeline (Feinabstimmung) ---------------------------------------------------------------
# EILKURIER_FETCH_INTERVAL_MINUTES=30
# EILKURIER_ARTICLE_RETENTION_DAYS=60
# EILKURIER_STORY_WINDOW_DAYS=14
