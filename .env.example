# Image-Version (Docker-Hub-Tag): latest oder ein Commit-Kürzel
EILKURIER_VERSION=latest
# Port der Weboberfläche/API im Heimnetz
EILKURIER_PORT=8080
TZ=Europe/Berlin

# Datenbank
POSTGRES_PASSWORD=bitte-aendern
# Optional: Datenbank auf einen festen Pfad der SSD legen statt in ein Docker-Volume
# EILKURIER_DB_DIR=/srv/dev-disk-by-uuid-XXXX/eilkurier/db
