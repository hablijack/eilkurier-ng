  "components": {
    "schemas": {
      "CatalogEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "added": {
            "type": "boolean",
            "title": "Added"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url",
          "category",
          "added"
        ],
        "title": "CatalogEntry"
      },
      "EditionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "reader_id": {
            "type": "integer",
            "title": "Reader Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "issue_date": {
            "type": "string",
            "format": "date",
            "title": "Issue Date"
          },
          "lead_headline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Headline"
          },
          "story_count": {
            "type": "integer",
            "title": "Story Count"
          },
